{
  "name": "gladys-vanderbilt-spc",
  "version": "0.1.1",
  "private": true,
  "description": "Gladys Assistant external integration for Vanderbilt SPC alarm panels through the Lundix SPC Web Gateway: areas (arm, opt-in disarm), zones, live events. Unofficial, not affiliated with Vanderbilt nor Lundix.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs",
    "validate:manifest": "npx --yes github:GladysAssistant/integration-store ."
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LM1LC3N7/gladys-vanderbilt-spc.git"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "license": "Apache-2.0"
}
